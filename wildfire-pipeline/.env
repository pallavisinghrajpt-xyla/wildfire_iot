# ============================================================
#  Wildfire detection pipeline — central configuration
#  Everything below is read by docker-compose.yml
# ============================================================

# ---- Public MQTT broker (HiveMQ public test broker) ----
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# IMPORTANT: change this to something long and unique to YOU.
# On a public broker anyone can publish/subscribe, so a unique
# prefix stops other people's test traffic colliding with yours.
TOPIC_PREFIX=wildfire-CHANGEME-a9f3kd7q

# ---- Kafka (internal to the docker network) ----
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_RAW_TOPIC=wildfire.sensors.raw

# ---- InfluxDB v2 ----
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=wildfire
INFLUX_BUCKET=sensors
# Change this token before doing anything real.
INFLUX_TOKEN=wildfire-admin-token-change-me
INFLUX_USERNAME=admin
INFLUX_PASSWORD=admin12345

# ---- Fire detection thresholds (used by the Flink job) ----
# A window "breaches" when temperature AND smoke both exceed these.
TEMP_THRESHOLD=45
SMOKE_THRESHOLD=1500
# Window length in seconds, and how many breaching readings within
# one window are required before an alert fires (sustained, not a spike).
WINDOW_SECONDS=30
MIN_BREACHES=3

# ---- Grafana ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
